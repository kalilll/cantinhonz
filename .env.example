# Porta do servidor
PORT=3000

# Senha do painel administrativo (texto puro só neste .env, nunca no código)
ADMIN_USER=admin
ADMIN_PASSWORD=troque-esta-senha

# Segredo usado para assinar o token de login do admin (qualquer string longa e aleatória)
JWT_SECRET=troque-por-uma-string-aleatoria-bem-grande

# Credenciais do Mercado Pago (conta do restaurante)
# Pegue em: https://www.mercadopago.com.br/developers/panel/app
MP_ACCESS_TOKEN=SEU_ACCESS_TOKEN_AQUI

# URL pública do site depois de publicado (usada para redirecionar o cliente após o pagamento)
PUBLIC_URL=http://localhost:3000

# Chave de API do Google Maps Platform (usada na geocodificação de endereços
# e no cálculo de frete por distância — só é necessária se a aba "Entrega" do
# admin estiver configurada no modo "Por distância (km)").
# Crie um projeto em https://console.cloud.google.com/, ative a "Geocoding API"
# (Menu > APIs e serviços > Biblioteca) e gere uma chave em "Credenciais".
# Recomendado: restrinja a chave por API (Geocoding API) e, se possível, por
# IP do servidor — nunca use uma chave sem restrição em produção.
GOOGLE_MAPS_API_KEY=

# Chave do Google Maps para uso NO NAVEGADOR (Places Autocomplete no campo de
# rua do checkout, sugestões de endereço enquanto o cliente digita).
# IMPORTANTE: use uma chave DIFERENTE da GOOGLE_MAPS_API_KEY acima — essa aqui
# fica visível no código-fonte da página (é normal e esperado pra chaves de
# navegador), então a segurança dela vem da restrição, não do sigilo:
# 1. Crie outra chave em "Credenciais".
# 2. Ative "Maps JavaScript API" e "Places API" pra ela.
# 3. Restrinja por "Referenciadores HTTP (sites)" com o(s) domínio(s) do site
#    (ex: https://seurestaurante.com.br/*) — NÃO restrinja por IP, não
#    funciona pra chamadas feitas do navegador do cliente.
# Se deixar em branco, o checkout funciona normalmente sem sugestões
# automáticas — o cliente digita o endereço manualmente (com a ajuda do CEP).
GOOGLE_MAPS_BROWSER_KEY=

# --- Notificações por Telegram (cozinha e entregador) ---
# Crie um bot com o @BotFather no Telegram para pegar o token, e converse com
# o @userinfobot (ou @get_id_bot) — ou adicione o bot num grupo — para
# descobrir o CHAT_ID de quem vai receber os avisos.
TELEGRAM_BOT_TOKEN=
# Chat que recebe o aviso de pedido pago (para a cozinha começar a preparar)
TELEGRAM_CHAT_ID_COZINHA=
# Chat que recebe os dados de entrega quando o pedido sai (se deixar em
# branco, usa o mesmo chat da cozinha)
TELEGRAM_CHAT_ID_ENTREGA=

# --- Bot do cardápio diário no WhatsApp ---
# Roda junto com o site neste mesmo processo. Se OWNER_NUMBER ficar em
# branco, o bot simplesmente não inicia (o site funciona normalmente sem ele).
# Veja server/whatsapp-bot/ e o README para o passo a passo completo.

# Numero do dono do restaurante, quem vai receber a previa e usar os comandos.
# Formato: codigo do pais + DDD + numero, sem simbolos. Ex: numero 86 99999-8888 = 5586999998888
OWNER_NUMBER=

# Horario em que o bot manda a previa do dia pro dono (formato cron)
# Exemplo abaixo: todo dia as 09:00
PREVIEW_CRON=0 9 * * *

# Fuso horario usado pra calcular o horario do cron acima.
TIMEZONE=America/Fortaleza

# Intervalo minimo e maximo (em segundos) entre cada envio pros clientes,
# pra nao mandar tudo de uma vez feito robo
DELAY_MIN_SECONDS=3
DELAY_MAX_SECONDS=8
