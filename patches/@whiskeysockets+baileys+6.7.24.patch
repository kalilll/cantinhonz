+// Correção do bug "Bad MAC" por descompasso LID/número de telefone — ver
+// https://github.com/WhiskeySockets/Baileys/pull/2763 (ainda não mesclado
+// oficialmente). Quando a sessão foi estabelecida sob um formato de
+// identidade (LID ou número) mas a mensagem chega endereçada pelo outro, a
+// busca de sessão falha mesmo já existindo uma sessão válida pro mesmo
+// dispositivo sob o outro endereço. O WhatsApp já manda os dois formatos
+// junto da mensagem (sender_pn/sender_lid em 1:1, participant_pn/
+// participant_lid em grupo) — usamos isso pra tentar de novo antes de desistir.
+function formaAlternativaDoUsuario(user, key) {
+    const altCandidato = isLidUser(user) ? (key.senderPn || key.participantPn) : (key.senderLid || key.participantLid);
+    return altCandidato && altCandidato !== user ? altCandidato : null;
+}
